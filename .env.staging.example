# Staging / QA only. Copy to the host's environment for the staging branch.
# Never set these on the Production environment of sawwiq.org.
# The app refuses to boot if STAGING_MODE=true and DATABASE_URL contains the
# live project dzedhnmxywtteeduwpby.

STAGING_MODE=true
LAUNCH_PHASE=full
# Staging code forces `full` and turns every feature on except prelaunch_home.
# These defaults match that, for a database that has not saved Admin → Features yet.
FEATURE_DEFAULTS=protected_payments=on,paid_plans=on,contracts=on,ndas=on,portfolio_import=on,quote_requests=on,ai_matchmaker=on,messaging=on,reviews=on,partners=on,collaboration=on,collaboration_delivery=on,collaboration_intelligence=on,demo_view=on,prelaunch_home=off
MONETIZATION_ENABLED=true
VIRTUAL_PAYMENTS=sandbox
PAYMENTS_PROVIDER=mock
PROTECTED_PAYMENTS_LIVE=false
SEO_INDEXABLE=false
ADMIN_REQUIRE_2FA=false
AUTH_SHOW_CODES=true
AI_PROVIDER=auto
STAGING_DEMO_PASSWORD=Staging-Qa-2026!

# Isolated database (project sawwiq-staging, ref klbjfgeoztmvtiolvjbk). Not the live project.
DATABASE_URL=
# Uploads go to the staging Supabase project; the app creates buckets "media" (public) and
# "media-private" (private) on first use. Never local here: on Vercel a local folder is per
# server and temporary, so uploaded photos vanish and show as broken images.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://klbjfgeoztmvtiolvjbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://staging.sawwiq.org
MFA_ENCRYPTION_KEY=
CRON_SECRET=
PAYMENTS_WEBHOOK_SECRET=
