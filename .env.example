# Copy to .env.local for development. Never commit real values.
# Every provider has a "mock" mode, so the app runs with none of these set.

# Public site URL, used for metadata and links in notifications
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Postgres connection string (Supabase > Project Settings > Database)
DATABASE_URL=

# Supabase project (server side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL and anon key, exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Transactional email
RESEND_API_KEY=

# SMS: mock | <jordanian gateway key, added in Sprint 7>
SMS_PROVIDER=mock
SMS_API_KEY=

# WhatsApp: mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=

# Payments: mock | hyperpay | meps
PSP_PROVIDER=mock
PSP_MERCHANT_ID=
PSP_SECRET=

# Analytics and errors
POSTHOG_KEY=
SENTRY_DSN=

# Shared secret for Vercel Cron requests
CRON_SECRET=
