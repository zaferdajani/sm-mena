# Copy to .env.local for development. Never commit real values.
# The app runs with NONE of these set: embedded Postgres (PGlite), local image
# storage, rule-based matchmaker, no Google ratings, everything free.

# ── Site ────────────────────────────────────────────────────────────────
# Public URL, used for metadata, sitemap and links in emails (build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────
# Empty = PGlite stored in PGLITE_DIR (single machine). Set a Postgres URL
# (Supabase, Neon, …) before running more than one app instance.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ── Image storage ───────────────────────────────────────────────────────
# local (default, files in UPLOADS_DIR) | supabase
STORAGE_PROVIDER=local
UPLOADS_DIR=.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI matchmaker ───────────────────────────────────────────────────────
# auto (default): Claude if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set.
# anthropic | openai: that one first, the other as backup when its key is set.
# mock: scripted offline AI for tests and demos (no key, no cost).
# basic: rule-based matchmaker only. Every failure falls back to it anyway.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# claude-opus-5 (best) or claude-haiku-4-5 (lowest cost)
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max (Claude models that support effort)
AI_EFFORT=medium
OPENAI_API_KEY=
# Any Responses-API model with function calling, e.g. gpt-4o-mini. Compare with
# `npm run ai:eval -- --provider openai,anthropic` before choosing.
OPENAI_MODEL=gpt-4o-mini
# Put a hard monthly spend limit on each provider's console, prepay a small
# amount and turn auto-recharge off. When a limit is hit, the next provider (or
# the free matchmaker) answers instead.

# ── Google Business Profile ratings ─────────────────────────────────────
# Places API (New) key. Empty = the "Connect Google" form is hidden.
GOOGLE_PLACES_API_KEY=
# Protects /api/cron/google (daily rating refresh). Send as Bearer token.
CRON_SECRET=

# ── Reviews ─────────────────────────────────────────────────────────────
# Days after contacting an agency through the platform before a client may review it.
REVIEW_MIN_DAYS=3

# ── Monetization ────────────────────────────────────────────────────────
# false = everything free and unlimited, no prices shown, no paid boost.
MONETIZATION_ENABLED=false

# ── Admin security ──────────────────────────────────────────────────────
# Encrypts two-factor (authenticator) secrets. Required in production; keep it
# stable (rotating it disables everyone's 2FA). `openssl rand -base64 32`
MFA_ENCRYPTION_KEY=
# Admins must use 2FA in production. false turns it off; true forces it in development.
ADMIN_REQUIRE_2FA=

# ── Payments ────────────────────────────────────────────────────────────
# mock: built-in test checkout, no real money (default). A Jordanian gateway
# (HyperPay, PayTabs, Tap…) is added as another provider in lib/payments/provider.ts.
PAYMENTS_PROVIDER=mock
# Platform fee on released protected-contract payments (percent). 0 during launch.
PLATFORM_FEE_PERCENT=0
# Signs provider notifications to /api/payments/webhook/<provider>. `openssl rand -hex 32`
PAYMENTS_WEBHOOK_SECRET=

# ── Statistics ──────────────────────────────────────────────────────────
# Page views are recorded in production only; set to 1 to record in development too.
NEXT_PUBLIC_TRACK_DEV=

# ── Email (inquiry notifications) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Seeding (npm run db:seed) ───────────────────────────────────────────
# Development defaults: admin@sawwiq.test / admin-pass-123, demo agencies use demo-pass-123.
# In production an admin is created only when both are set (password 12+ characters),
# and demo agency passwords are random unless SEED_DEMO_PASSWORD is set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# Docker/Fly entrypoint: seed fictional demo agencies on first boot.
SEED_DEMO=false
